{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["model", "webui"],
  "properties": {
    "model": {
      "type": "string",
      "description": "Ollama model to pull on deploy (e.g. llama3.2:3b, mistral:7b)"
    },
    "webui": {
      "type": "object",
      "required": ["adminEmail"],
      "properties": {
        "adminEmail": {
          "type": "string",
          "description": "Email address that becomes admin on first login"
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": { "type": "string" }
          }
        }
      }
    },
    "ollama": {
      "type": "object",
      "properties": {
        "gpu": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": { "type": "string" }
          }
        }
      }
    }
  }
}
